{
  "name": "firefox-webextension-types",
  "version": "0.1.0",
  "description": "Strictly-typed TypeScript definitions for Firefox WebExtensions, generated directly from Mozilla central schemas with zero unvetted any",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "typesVersions": {
    "*": {
      "desktop": [
        "dist/firefox-desktop.d.ts"
      ],
      "mobile": [
        "dist/firefox-mobile.d.ts"
      ],
      "global": [
        "dist/global.d.ts"
      ],
      "global-chrome": [
        "dist/global-chrome.d.ts"
      ],
      "global-mobile": [
        "dist/global-mobile.d.ts"
      ],
      "global-mobile-chrome": [
        "dist/global-mobile-chrome.d.ts"
      ],
      "chrome": [
        "dist/chrome.d.ts"
      ],
      "provenance.json": [
        "dist/provenance.json"
      ]
    }
  },
  "files": [
    "dist",
    "LICENSE-MPL-2.0",
    "LICENSE-CHROMIUM",
    "NOTICE"
  ],
  "scripts": {
    "build": "node src/generate.js",
    "verify": "node verification/bin/verify.js && node scripts/verify-parity.js",
    "test": "node --test test/*.test.js verification/test/*.test.js",
    "typecheck": "tsc --noEmit",
    "ablate": "node scripts/ablate.js",
    "ledger:update": "node scripts/ledger-update.js",
    "attw": "attw --pack ."
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/chrome": "^0.3.7",
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/patrickkettner/firefox-webextension-types.git"
  },
  "keywords": [
    "firefox",
    "webextensions",
    "typescript",
    "types"
  ],
  "license": "Apache-2.0 AND MPL-2.0 AND BSD-3-Clause",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./desktop": {
      "import": {
        "types": "./dist/firefox-desktop.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/firefox-desktop.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./mobile": {
      "import": {
        "types": "./dist/firefox-mobile.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/firefox-mobile.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./chrome": {
      "import": {
        "types": "./dist/chrome.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/chrome.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": "./dist/index.js"
    },
    "./global": {
      "types": "./dist/global.d.ts",
      "default": "./dist/index.js"
    },
    "./global-chrome": {
      "types": "./dist/global-chrome.d.ts",
      "default": "./dist/index.js"
    },
    "./global-mobile": {
      "types": "./dist/global-mobile.d.ts",
      "default": "./dist/index.js"
    },
    "./global-mobile-chrome": {
      "types": "./dist/global-mobile-chrome.d.ts",
      "default": "./dist/index.js"
    },
    "./provenance.json": "./dist/provenance.json",
    "./package.json": "./package.json"
  }
}
